{"session": "nolan-check", "action": "evaluate", "code": "(function(){var modal=document.querySelector(\"[class*=modal].active,[class*=modal][style*=block],[class*=dialog].active\");var conf=Array.from(document.querySelectorAll(\"[class*=submit],button,a\")).find(function(e){return (e.textContent||\"\").trim()===\"确认并发布\"&&e.offsetParent});var warns=[];document.querySelectorAll(\"[class*=error],[class*=warn]\").forEach(function(e){var x=(e.textContent||\"\").trim();if(x&&x.length<60&&e.offsetParent)warns.push(x)});return JSON.stringify({modalVisible:!!modal,confirmBtn:!!conf,warns:warns.slice(0,5),url:location.href})})()"}