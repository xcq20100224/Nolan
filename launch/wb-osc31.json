{"session": "nolan-check", "action": "evaluate", "code": "(function(){var sel=Array.from(document.querySelectorAll(\"select\")).map(function(s){return {name:s.name,id:s.id,val:s.value,opts:Array.from(s.options).slice(0,10).map(function(o){return o.textContent.trim()})}});var dd=[];document.querySelectorAll(\"[class*=dropdown],[class*=select],[class*=category],[class*=catalog]\").forEach(function(e){var t=(e.textContent||\"\").trim();if(t&&t.length<30&&e.offsetParent&&dd.indexOf(t)<0)dd.push(t)});return JSON.stringify({selects:sel,dd:dd.slice(0,12)})})()"}