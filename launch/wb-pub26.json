{"session":"nolan-check","action":"evaluate","code":"(function(){var dd=document.querySelector('.dropdown-menu.show');if(!dd)return 'CLOSED';var items=Array.from(dd.querySelectorAll('*')).filter(function(e){return e.children.length===0&&(e.textContent||'').trim()}).map(function(e){return (e.textContent||'').trim()+'<'+e.tagName+'.'+(e.className||'').toString().slice(0,30)+'>'});return JSON.stringify(items.slice(0,50))})()"}
