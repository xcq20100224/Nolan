{"session":"nolan-check","action":"evaluate","code":"(function(){var w=window.__tagWrap;if(!w)return 'NO_WRAP';var inputs=Array.from(w.querySelectorAll('input')).map(function(e){return {ph:e.placeholder||'',vis:!!e.offsetParent}});var tabs=Array.from(w.querySelectorAll('a,button,li')).map(function(e){return (e.textContent||'').trim()}).filter(function(t){return t&&t.length<10}).slice(0,20);return JSON.stringify({inputs:inputs,tabs:tabs})})()"}
