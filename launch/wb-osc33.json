{"session": "nolan-check", "action": "evaluate", "code": "(function(){var lb=Array.from(document.querySelectorAll(\"label\")).find(function(e){return (e.textContent||\"\").trim()===\"推广专区\"});if(!lb)return \"NO_LABEL\";var box=lb.parentElement;var sel=Array.from(box.querySelectorAll(\"*\")).find(function(e){return (e.textContent||\"\").trim()===\"请选择\"&&e.children.length===0});if(!sel)return \"NO_SEL html=\"+box.innerHTML.slice(0,200);var clickTarget=sel.closest(\"[class*=select],[class*=dropdown]\")||sel.parentElement;clickTarget.click();return \"CLICKED \"+(clickTarget.className||\"\").toString().slice(0,50)})()"}